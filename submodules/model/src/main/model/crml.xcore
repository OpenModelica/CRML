@GenModel(
    bundleManifest="false",
    modelDirectory="crml-model/src-gen",
    complianceLevel="8.0"
)
package crml.model.language

/*
 * Entity of a CRML model that has a name.
 */
abstract class NamedEntity {
    /*
     * Unique identifier of the entity.
     */
    id String name
}

/////////////////////////////
// ??????????????????????? //
/////////////////////////////

/*
 * Named element of a CRML model, such as a variable, that may have a value.
 * The value is either given by a {@link #getDefinition() definition} or
 * provided from outside the model (external).
 */
abstract class Element extends NamedEntity{
    // TODO: must have a domain
    // TODO: must have a name
    // TODO: name must be unique in the class
    /*
     * Value of the element, from its {@code is} clause.
     * Null when the element is declared without a value.
     */
    contains Value definition
    /*
     * True if the value of the element is provided from outside the
     * requirement model ({@code is external}).
     */
    Boolean external // TODO mutually exclusive with definition
}

/*
 * Typed variable. Declared in a {@link Model} or a {@link Class}, or
 * as a parameter in the {@link CustomOperator#getHeader() header} of an operator.
 */
class Variable extends Element, OperatorHeaderElement {
    /*
     * Type of the variable.
     */
    contains TypeReference domain
    /*
     * True if the variable is declared {@code constant}.
     */
    Boolean constant

}

/*
 * Instance of a {@link Class}.
 * Not produced by the parser yet.
 */
abstract class Object extends Element {
    /*
     * {@link Class} of the object.
     */
    refers Class domain
    /*
     * Variables of the object.
     */
    contains Variable[] variables
    /*
     * Objects contained in the object.
     */
    contains Object[] objects
    /*
     * Sets contained in the object.
     */
    contains Set<?>[] sets
    /*
     * Time period in which the object is evaluated.
     */
    contains Period frame //Optional to have
}

/*
 * Assignment that binds an {@link Element} to a {@link Value}.
 * Used for the named arguments of a {@link ConstructorValue}, and for the
 * arguments of a {@link ComputedValue}, where the element is a parameter of the
 * called operator.
 */
class Binding {
    /*
     * {@link Element} that receives the value.
     */
    refers Element element
    /*
     * {@link Value} to be assigned to the element.
     */
    contains Value value
}

/////////////////////////////
// Templates and Operators //
/////////////////////////////

/*
 * Superclass of all CRML Operators.
 */
abstract class Operator extends NamedEntity{
    /*
     * Return type of the {@link Operator}.
     */
    contains TypeReference domain
    //override getName() {
    //    return "Placeholder operator name";
    //}
}

/*
 * Built-in unary operations in CRML.
 */
enum BuiltinUnaryOperatorKind {
    /*
     * Parity operator.
     */
    PAR = 14
    PRE = 16
    /*
     * Negation for Boolean4 ({@code not}).
     */
    NOT = 17
    /*
     * Cardinality operator for sets ({@code card}).
     * For a Clock, it is the number of ticks.
     */
    CARD = 18
    /*
     * Base 10 logarithm ({@code log10}).
     */
    LOG10 = 24
    /*
     * Cosine ({@code cos}).
     */
    COS = 25
    /*
     * Arc cosine ({@code acos}).
     */
    ACOS = 26
    /*
     * Sine ({@code sin}).
     */
    SIN = 27
    /*
     * Arc sine ({@code asin}).
     */
    ASIN = 28
    /*
     * Opening event of a Period ({@code P start}).
     */
    START = 29   // right_op: exp 'start'
    /*
     * Closing event of a Period ({@code P end}).
     */
    END = 30     // right_op: exp 'end'
    /*
     * Parentheses around an expression.
     */
    SUBEXPRESSION = 31
    /*
     * Exponential function ({@code exp}).
     */
    EXP_OP = 101
    /*
     * Negation, subtraction from 0 ({@code -}).
     */
    SUB = 102 // has both unary and binary form
    /*
     * Unary plus, addition to 0 ({@code +}).
     */
    ADD = 103 // has both unary and binary form
    /*
     * Natural logarithm ({@code log}).
     */
    LOG = 104 // has both unary and binary form
    /*
     * Event of the current tick of a Clock ({@code tick c}).
     */
    TICK = 51
}

/*
 * Built-in {@link Operator} with one argument.
 */
class UnaryOperator extends Operator, Value {
    /*
     * Type of operation.
     */
    BuiltinUnaryOperatorKind optype
    /*
     * Input of operation.
     */
    contains Value value
}
/*
 * Built-in binary operations.
 */
enum BuiltinBinaryOperatorKind {
    /*
     * Conjunction ({@code and}).
     */
    AND = 0
    /*
     * Multiplication ({@code *}).
     */
    MUL = 1
    /*
     * Addition ({@code +}).
     */
    ADD = 2
    /*
     * Subtraction ({@code -}).
     */
    SUB = 3
    /*
     * Division ({@code /}).
     */
    DIV = 4
    WITH = 5
    MASTER = 6
    ON = 7
    /*
     * Ticks of a Clock for which a condition holds ({@code c filter cond}).
     */
    FILTER = 8
    /*
     * Less or equal than ({@code <=}).
     * At most.
     */
    LE = 9
    /*
     * Less than ({@code <}).
     */
    LT = 10
    /*
     * Greater or equal than ({@code >=}).
     * At least.
     */
    GE = 11
    /*
     * Greater than ({@code >}).
     */
    GT = 12
    /*
     * Not equals ({@code <>}).
     */
    NEQ = 13
    PAR = 14
    /*
     * Equals ({@code ==}).
     */
    EQ = 15
    /*
     * Disjunction ({@code or}).
     */
    OR = 19
    /*
     * Power ({@code ^}).
     */
    POW = 20
    /*
     * Modulo ({@code mod}).
     */
    MOD = 21
    /*
     * Logarithm.
     */
    LOG = 23
    /*
     * Value of the left operand at the ticks of a Clock ({@code x at c}).
     */
    AT = 101
}


/*
 * Built-in {@link Operator} with two arguments.
 */
class BinaryOperator extends Operator, Value {
    /*
     * Type of operation.
     */
    BuiltinBinaryOperatorKind optype
    /*
     * Second argument of the operator (right hand side).
     */
    contains Value rhs
    /*
     * First argument of the operator (left hand side).
     */
    contains Value lhs
}

/*
 * {@link Operator} defined in CRML. Its signature is a sequence of keywords and
 * parameters, so calls to it can be written in natural language syntax.
 */
abstract class CustomOperator extends Operator {
    /*
     * Signature elements of an operator.
     * Sequence of {@link Variable} parameters and {@link Keyword} objects
     * in the order they are declared.
     */
    contains OperatorHeaderElement[] header
    /*
     * Computation method of the operator: the expression after {@code =},
     * which refers to the parameters of the {@link #getHeader() header}.
     */
    contains Value definition

    /*
     * Keywords of the {@link CustomOperator} header.
     */
    op Keyword[] getKeywords() {
        header.filter(Keyword).toEList
    }
    /*
     * Variables declared in the {@link CustomOperator} header.
     */
    op Variable[] getVariables() {
        header.filter(Variable).toEList
    }
    /*
     * Number of arguments of the {@link CustomOperator}.
     */
    op int getArity() {
        header.filter(Variable).size
    }
    /*
     * True if the first {@link #getHeader() header} element is a {@link Variable}.
     */
    op boolean startsWithValue() {
        !header.isEmpty && header.head instanceof Variable
    }
    /*
     * True if the last {@link #getHeader() header} element is a {@link Variable}.
     */
    op boolean endsWithValue() {
        !header.isEmpty && header.get(header.size - 1) instanceof Variable
    }
}

/*
 * Template: a {@link CustomOperator} on Booleans.
 * Its parameters are untyped in CRML ({@code Template a w b = ...}), so the
 * parameters and the return type are all Boolean.
 */
class Template extends CustomOperator {

}

/*
 * User-defined operator with typed parameters and an explicit return type
 * ({@code Operator [T] w T1 a = ...}).
 */
class UserOperator extends CustomOperator {

}

/*
 * Element of a {@link CustomOperator#getHeader() operator header}:
 * either a {@link Variable} parameter or a {@link Keyword}.
 */
abstract class OperatorHeaderElement {

}

/*
 * Word of the name of a {@link CustomOperator}, in its
 * {@link CustomOperator#getHeader() header}.
 */
class Keyword extends OperatorHeaderElement{
    /*
     * The word as written in the source.
     */
    String keyword
}

