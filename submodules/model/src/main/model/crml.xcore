// Types //
///////////
abstract class Domain {
    // TODO: A domain is a finite or infinite set of elements of the same kind. 
    // TODO: a domain can be extended
    // TODO: a domain can be specialized
    // TODO: a domain can be partial
    Boolean partial
    // TODO: a domain can be aliased
}

class CRMLType {
    // TODO: Therefore, the words ‘type’ and ‘domain’ are synonymous. (specs)
}

class Clock {

}

class DiscreteClock {

}

class Period {
    refers Event start
    refers Event end
}

class Periods {
    refers Period[] Periods
    // TODO event based generator?
}

class Boolean4 {
    refers BooleanConstant value // TODO??
}

class Requirement extends Boolean4 {
    // TODO should this be implemented in CRML?
}
class Event {
    refers Boolean4 boolean
}

//class Operator { implemented elsewhere
//
//}

class Category extends Operator{
    // Categories are operators on operators.
    refers Operator f
}

class Set<D> extends Element {
    refers D[] elements
}

class Class extends Domain, NamedEntity {
    // Domain of all objects, have the same attributes but no devinition (is it really practical? default values?)
    // TODO: A domain is a finite or infinite set of elements of the same kind. 
    // TODO: a domain can be extended
    // TODO: a domain can be specialized
    // TODO: a domain can be partial
    // Boolean partial // inherits from domain
    // TODO: a domain can be aliased

    refers ClassDependency[] superClasses

    // TODO class specialization
}

class ClassDependency extends ProxyElement {

}

class PowerClass {
    // sets of objects of Class c (from specs)
    // TODO where it isu used? 
}

class Library {
    //contains Element[] elements // TODO derived maybe?
    contains Dependency[] superlibs
    // TODO: A library can contain domain extensions
    // TODO: A library can contain domain specializations
    contains Class[] classes
    contains Operator[] operators
    //contains Template[] templates // Not in specs, but might be good to have
    // TODO: A library can contain categories
}

class Model extends Library{
    contains Object[] objects
    contains Variable[] varaibles
    contains Set<?>[] sets
    contains Period frame
}

class Package {
    contains Package[] subpackages
    contains Library[] libraries
    contains Model[] models
}

/////////////////////
// Primitive times //
/////////////////////

enum BooleanLiteral {
    TRUE = 0
    FALSE = 1
    UNDECIDED = 2
    UNDEFINED = 3
}

class NaturalNumber {

}

