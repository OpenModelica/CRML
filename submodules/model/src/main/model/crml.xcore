///////////////////////
// Ideas for values and Expressions
/////////////////////////

abstract class Value {

}

class VaraibleReference extends Value {
    refers Variable variable
}

class ComputedValue extends Value {
    refers Operator operator
}

abstract class ConstantValue extends Value {

}

class BooleanConstant extends ConstantValue {
    BooleanLiteral value
}

class IntegerConstant extends ConstantValue {
    Integer value
}

class RealConstant extends ConstantValue {
    Double value
}

class StringConstant extends ConstantValue {
    String value
}

///////////
// Types //
///////////

abstract class TypeReference {

}

class BuiltinTypeReference extends TypeReference {
    BuiltinType builtinType
}

enum BuiltinType { // TODO: Change string literal to modelica connector names
    STRING = 0,
    BOOLEAN = 1,
    REAL = 2
}

class UserTypereference extends TypeReference {
    String typeName // TODO: it has to be resolved to a Class or Type.
}

//////////////////
// Dependencies //
//////////////////

abstract class Dependency {

}

class ModelDependency extends Dependency {
    refers Model referedModel
}

class ProxyDependency extends Dependency, ProxyElement {

}

/////////////
// Proxies //
/////////////

class ProxyElement {
    String name
}