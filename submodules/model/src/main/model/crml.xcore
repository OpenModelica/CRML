/*
 * Values of a four-valued Boolean.
 */
enum BooleanLiteral {
    /*
     * {@code true}.
     */
    TRUE = 0
    /*
     * {@code false}.
     */
    FALSE = 1
    /*
     * {@code undecided}: the value cannot be decided yet.
     */
    UNDECIDED = 2
    /*
     * {@code undefined}: the value is not defined.
     */
    UNDEFINED = 3
}

/*
 * Natural number.
 * Not used yet.
 */
class NaturalNumber {

}

