///////////
/*
 * Set of elements of the same kind.
 */
abstract class Domain {
    // TODO: A domain is a finite or infinite set of elements of the same kind.
    // TODO: a domain can be extended
    // TODO: a domain can be specialized
    // TODO: a domain can be partial
    /*
     * True if the domain is declared {@code partial}.
     */
    Boolean partial
    // TODO: a domain can be aliased
}

/*
 * CRML type. In CRML, "type" and "domain" are synonymous.
 * Not used yet.
 */
class CRMLType {
    // TODO: Therefore, the words ‘type’ and ‘domain’ are synonymous. (specs)
}

/*
 * Clock: a set of time instants (ticks).
 * Not used yet, the type is referred to as {@link BuiltinType#CLOCK}.
 */
class Clock {

}

/*
 * Discrete clock.
 * Not used yet.
 */
class DiscreteClock {

}

/*
 * Single time period between an opening and a closing {@link Event}.
 * Not used yet, the type is referred to as {@link BuiltinType#PERIOD}.
 */
class Period {
    /*
     * Opening event of the period.
     */
    refers Event start
    /*
     * Closing event of the period.
     */
    refers Event end
}

/*
 * Multiple time periods.
 * Not used yet, the type is referred to as {@link BuiltinType#PERIODS}.
 */
class Periods {
    /*
     * The time periods.
     */
    refers Period[] Periods
    // TODO event based generator?
}

/*
 * Four-valued Boolean: true, false, undecided or undefined.
 * Not used yet, the type is referred to as {@link BuiltinType#BOOLEAN}.
 */
class Boolean4 {
    /*
     * Value of the Boolean.
     */
    refers BooleanConstant value // TODO??
}

/*
 * Requirement: a {@link Boolean4} that states whether a requirement is satisfied.
 * Not used yet, the type is referred to as {@link BuiltinType#REQUIREMENT}.
 */
class Requirement extends Boolean4 {
    // TODO should this be implemented in CRML?
}
/*
 * Event: the instant at which a Boolean becomes true.
 * Not used yet, the type is referred to as {@link BuiltinType#EVENT}.
 */
class Event {
    /*
     * The Boolean that triggers the event.
     */
    refers Boolean4 boolean
}

//class Operator { implemented elsewhere
