///////////////////////
// Ideas for values and Expressions
/////////////////////////

/*
 * Expression in a CRML model.
 */
abstract class Value {
    /*
     * Type of the value of the expression.
     * Set by the parser for constants only, null otherwise.
     */
    contains TypeReference returnType
}

/*
 * Reference to a {@link Variable} by its name.
 */
class VariableReference extends Value {
    /*
     * The referenced variable.
     */
    refers Variable variable
}

/*
 * Call to a {@link CustomOperator}.
 * The parser produces it from a {@link Sequence}, by matching the keywords
 * and arguments against the headers of the operators in scope.
 */
class ComputedValue extends Value {
    /*
     * The called operator.
     */
    refers CustomOperator operator
    /*
     * Arguments of the call, bound to the parameters of the
     * {@link #getOperator() operator}.
     */
    contains Binding[] bindings
}

/*
 * Time period between two events, written {@code [e1, e2]}.
 * A {@code [} on the left or a {@code ]} on the right includes that end.
 */
class PeriodsValue extends Value {
    /*
     * True if the period includes its start ({@code [e1, ...}).
     */
    Boolean isStartInclusive
    /*
     * True if the period includes its end ({@code ..., e2]}).
     */
    Boolean isEndInclusive
    /*
     * Opening event of the period.
     */
    contains Value startValue
    /*
     * Closing event of the period.
     */
    contains Value endValue
}

/*
 * Integration of a value over time periods ({@code integrate x on P}).
 */
class IntegrateValue extends Value {
    /*
     * Integrated value.
     */
    contains Value integrand
    /*
     * Time periods to integrate over.
     */
    contains Value interval
}

/*
 * Duration for which a Boolean is true within time periods
 * ({@code duration b on P}).
 */
class DurationValue extends Value {
    /*
     * The Boolean whose duration is measured.
     */
    contains Value exp1
    /*
     * Time periods in which the duration is measured.
     */
    contains Value exp2
}

/*
 * Projection of an event or clock on a clock ({@code e proj c}),
 * optionally bounded ({@code e proj(d) c}).
 */
class ProjectionValue extends Value {
    /*
     * Projected event or clock (left of {@code proj}).
     */
    contains Value p1
    /*
     * Clock to project on (right of {@code proj}).
     */
    contains Value p2
    /*
     * Bound of the projection, in parentheses after {@code proj}.
     * Null for an unbounded projection.
     */
    contains Value opt
}

/*
 * Conditional expression ({@code if c then a else b}).
 */
class IfValue extends Value {
    /*
     * The condition.
     */
    contains Value condition
    /*
     * The value if the condition is true.
     */
    contains Value then
    /*
     * The value if the condition is false.
     */
    contains Value othervise
}

/*
 * Construction of a value of a type ({@code new T ...}). Either
 * <ul>
 * <li>{@code new T (a = x, b = y)}: the {@link #getBindings() bindings} are set,</li>
 * <li>{@code new T x}: the {@link #getValue() value} is set, or</li>
 * <li>{@code new T}: neither is set, it is the default constructor.</li>
 * </ul>
 */
class ConstructorValue extends Value {
    /*
     * Type of the constructed value.
     */
    contains TypeReference domain

    //TODO: (validation) bindings and value should be mutually exclusive
    /*
     * Values of the variables of the constructed type, by name.
     */
    contains Binding[] bindings
    /*
     * Value to convert to the constructed type.
     */
    contains Value value

}

/*
 * Literal value in the source.
 */
abstract class ConstantValue extends Value {

}

/*
 * Boolean literal ({@code true}, {@code false}, {@code undecided} or {@code undefined}).
 */
class BooleanConstant extends ConstantValue {
    /*
     * The literal.
     */
    BooleanLiteral value
}

/*
 * Integer literal.
 */
class IntegerConstant extends ConstantValue {
    /*
     * The value of the literal.
     */
    Integer value
}

/*
 * Real literal.
 */
class RealConstant extends ConstantValue {
    /*
     * The literal as written in the source.
     */
    String literal
    /*
     * The value of the literal.
     */
    Double value
}

/*
 * The current time ({@code time}).
 */
class TimeValue extends ConstantValue{
    // in the grammar this is handled as a constant. not sure why
}

/*
 * String literal.
 */
class StringConstant extends ConstantValue {
    /*
     * The string without the enclosing quotes. Escape sequences are kept as written.
     */
    String rawString
}

// Sequences are raw containers for natural language operator calls
// An object model shall be free of any Sequence
// Sequences should be transformed to function calls
/*
 * Linked list of the keywords and values of a natural language operator call,
 * as parsed before the called operator is known.
 * Sequences are replaced by {@link ComputedValue} calls, a model must not
 * contain any after parsing.
 */
abstract class Sequence extends Value {
    /*
     * The next element of the sequence, or null for the last one.
     */
    op Sequence getNext()
    /*
     * Sets the next element of the sequence. Throws an
     * {@link IllegalArgumentException} if this element cannot be followed by {@code next}.
     */
    op void setNext2(Sequence next)


    /*
     * The last element of the sequence.
     */
    op Sequence tail() {
        if (getNext() === null) {
            return this
        } else {
            return getNext().tail()
        }
    }
}

/*
 * Value in a {@link Sequence}. It can only be followed by a {@link SequenceKeyword}.
 */
class SequenceValue extends Sequence {
    /*
     * The next element of the sequence.
     */
    contains SequenceKeyword next
    /*
     * The value.
     */
    contains Value value

    op void setNext2(Sequence next) {
        if (next instanceof SequenceKeyword) {
            setNext(next as SequenceKeyword)
        } else {
            throw new IllegalArgumentException(
                "Incompatible type for next: " + next.eClass().getName())
        }

    }
}

/*
 * Keyword in a {@link Sequence}.
 */
class SequenceKeyword extends Sequence {
    /*
     * The next element of the sequence.
     */
    contains Sequence next
    /*
     * The keyword as written in the source.
     */
    String keyword

    op void setNext2(Sequence next) {
        setNext(next)
    }
}
///////////
// Types //
///////////

/*
 * Reference to a type.
 */
abstract class TypeReference {

}

/*
 * Reference to a type through another {@link TypeReference}.
 * Not produced by the parser yet.
 */
class IndirectTypeReference extends TypeReference {
    /*
     * The referred type reference.
     */
    refers TypeReference referredType
}

/*
 * Reference to a {@link BuiltinType}.
 */
class BuiltinTypeReference extends TypeReference {
    /*
     * The referred built-in type.
     */
    BuiltinType builtinType
}

/*
 * Types built into CRML.
 */
enum BuiltinType { // TODO: Change string literal to modelica connector names
    /*
     * {@code String}.
     */
    STRING = 0,
    /*
     * {@code Boolean}, a four-valued Boolean.
     */
    BOOLEAN = 1,
    /*
     * {@code Integer}.
     */
    INTEGER = 2,
    /*
     * {@code Real}.
     */
    REAL = 3,
    /*
     * {@code Event}.
     */
    EVENT = 4,
    /*
     * {@code Clock}.
     */
    CLOCK = 5,
    /*
     * {@code Period}, a single time period.
     */
    PERIOD = 6,
    /*
     * {@code Periods}, multiple time periods.
     */
    PERIODS = 7,
    /*
     * {@code Requirement}.
     */
    REQUIREMENT = 8
}

/*
 * Reference to a user-defined type, such as a {@link Class}, by its name.
 */
class UserTypereference extends TypeReference {
    /*
     * The referred type.
     */
    refers Domain domain
}

//////////////////
// Dependencies //
//////////////////

/*
 * Dependency of a {@link Library} on another library or model.
 */
abstract class Dependency {

}

/*
 * Dependency on a {@link Model}.
 * Not produced by the parser yet, and not supported by the compiler.
 */
class ModelDependency extends Dependency {
    /*
     * The model depended on.
     */
    refers Model referedModel
}
