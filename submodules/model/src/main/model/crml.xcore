//}

/*
 * Category: an operator on operators, mapping each operator to another
 * ({@code Category c = { (f1, g1), ... }}).
 * Not produced by the parser yet, and not supported by the compiler.
 */
class Category extends Operator{
    // Categories are operators on operators.
    /*
     * The mapped operator.
     */
    refers Operator f
}

/*
 * Set of values of type {@code D}, written as {@code { e1, e2, ... }}.
 */
class Set<D> extends Element, Value {
    /*
     * Type of the elements of the set.
     */
    contains TypeReference domain
    /*
     * Elements of the set.
     */
    contains D[] elements
}

/*
 * CRML class: a {@link Domain} of objects that have the same variables.
 */
class Class extends Domain, NamedEntity {
    // Domain of all objects, have the same attributes but no devinition (is it really practical? default values?)
    // TODO: A domain is a finite or infinite set of elements of the same kind.
    // TODO: a domain can be extended
    // TODO: a domain can be specialized
    // TODO: a domain can be partial
    // Boolean partial // inherits from domain
    // TODO: a domain can be aliased

    /*
     * Classes that this class extends.
     */
    refers Class[] superClasses

    /*
     * Variables declared in the class.
     */
    contains Variable[] variables

    // TODO class specialization
}

/*
 * Set of objects of a {@link Class}.
 * Not used yet.
 */
class PowerClass {
    // sets of objects of Class c (from specs)
    // TODO where it isu used?
}

/*
 * CRML library: a reusable collection of classes and operators
 * ({@code library L is { ... };}).
 */
class Library extends NamedEntity {
    //contains Element[] elements // TODO derived maybe?
    /*
     * Libraries and models that this one is built upon ({@code L union}).
     * Not filled in by the parser yet.
     */
    contains Dependency[] superlibs
    // TODO: A library can contain domain extensions
    // TODO: A library can contain domain specializations
    /*
     * Classes declared in the library.
     */
    contains Class[] classes
    /*
     * Operators and templates declared in the library.
     */
    contains Operator[] operators
    //contains Template[] templates // Not in specs, but might be good to have
    // TODO: A library can contain categories
}

/*
 * CRML model: the root of a requirement model ({@code model M is { ... };}).
 * In addition to the contents of a {@link Library}, it declares the variables
 * and objects that the requirements are expressed on.
 */
class Model extends Library {
    /*
     * Objects declared in the model.
     */
    contains Object[] objects
    /*
     * Variables declared in the model.
     */
    contains Variable[] variables
    /*
     * Sets declared in the model.
     */
    contains Set<?>[] sets
    /*
     * Time period in which the model is evaluated.
     */
    contains Period frame
}

/*
 * CRML package: a hierarchy of libraries and models.
 * Not supported by the parser yet.
 */
class Package {
    /*
     * Packages nested in this package.
     */
    contains Package[] subpackages
    /*
     * Libraries in this package.
     */
    contains Library[] libraries
    /*
     * Models in this package.
     */
    contains Model[] models
}

