@GenModel(
    bundleManifest="false",
    modelDirectory="crml-model/src-gen",
    complianceLevel="8.0"
)
package crml.model.language

import org.eclipse.emf.common.util.BasicEList

abstract class NamedEntity {
    String name
}

abstract class Domain extends NamedEntity {
    refers Domain[] extendz
    refers Domain[] specializes
    boolean partial
    String[] aliases
} // Everything should be a domain and a somain should be a set.

abstract class Element extends NamedEntity {
    // elements have names and values
    // names are unique within a set
}

abstract class Variable extends Element{
    refers Domain typee
    boolean constant
}

class Objects extends Element {
    refers Domain typee
    contains Element[] elements
}

abstract class Value { }

abstract class Definition { }

class ElementDefinition extends Definition {
    refers Domain typee
    boolean external
    contains Value value

}
// ─── Operators ───────────────────────────────────────────────────────────────

abstract class SetOperator { }

class UnarySetOperator extends SetOperator { }

class BinarySetOperator extends SetOperator { }

class FilterSetOperator extends SetOperator { }

// ─── Top-level definition ────────────────────────────────────────────────────

class Model extends Domain {
    contains Model[] models
    contains Clazz[] classes
    contains Operator[] Operators
    contains Category[] categories
    contains Objects[] Objects
    contains Variable[] variables
    // contains Set[] sets // What is this?
    // contains FramePeriod frame // What is this?
    refers derived Operator[] allOperators get {
        val result = new BasicEList<Operator>()
        result.addAll(getOperators)
        for (d : getExtendz) {
            if (d instanceof Model) {
                result.addAll((d as Model).allOperators)
            }
        }
        return result
    }
}

class Library extends NamedEntity { // Probably just be a set, not a domain
    contains Library[] libraries
    contains Domain[] domainExtensions
    contains Domain[] domainSpecialization
    contains Clazz[] classes
    contains Operator[] Operators
    contains Category[] categories
}

class Package extends NamedEntity {
    contains Package[] packages
    contains Library[] libraries
    contains Model[] models
}

class Clazz {} //TODO
// ─── Utilities ───────────────────────────────────────────────────────────────

abstract class SignatureElement {}

class Keyword extends SignatureElement {
    String keyword
}

class Parameter extends SignatureElement {
    refers Domain typee
    String name
}

// ─── Operators and Templates ─────────────────────────────────────────────────
abstract class Expression { }

//class RawExpression extends Expression { } // Implemented in java to hold/wrap the AST?

class Category extends Domain { }

abstract class Operator {
    refers Domain returnType
    refers SignatureElement[] parameters
    contains Category category
}

abstract class Template extends Operator {}

class CallArgument {
    refers Parameter parameter
    refers Expression expression
}

class OperatorCall extends Expression {
    refers Operator target
}


// ─── Operators ────────────────────────────────────────────────────────────────
class Op {}//TODO (placeholder?)

class BuiltinOp extends Expression {
    BuiltinOpKind kind
}

class UserKeywordOp extends Op {
    String keyword
}

enum BuiltinOpKind {
    AND = 0
    MUL = 1
    ADD = 2
    SUB = 3
    DIV = 4
    WITH = 5
    MASTER = 6
    ON = 7
    FILTER = 8
    LE = 9
    LT = 10
    GE = 11
    GT = 12
    NEQ = 13
    PAR = 14
    EQ = 15
    PRE = 16
    NOT = 17
    CARD = 18
    OR = 19
    POW = 20
    MOD = 21
    EXP_OP = 22
    LOG = 23
    LOG10 = 24
    COS = 25
    ACOS = 26
    SIN = 27
    ASIN = 28
    START = 29   // right_op: exp 'start'
    END = 30     // right_op: exp 'end'
}

// ─── Types ───────────────────────────────────────────────────────────────────

class TypeRef {
    BuiltinType builtinKind   // NONE means the type is named via typeName
    String typeName           // set when builtinKind == NONE
    boolean isSett             // true when '{}' suffix is present // isSet is a reserved keyword? (causes parse error)
}

enum BuiltinType {
    NONE = 0
    INTEGER = 1
    REAL = 2
    BOOLEAN = 3
    STRING = 4
    CLOCK = 5
    SET = 6
    PERIOD = 7
    PERIODS = 8
    EVENT = 9
    REQUIREMENT = 10
}

enum VarQualifier {
    NONE = 0
    FIXED = 1
}

enum StructureTypeKind {
    TYPE = 0
    CLASS = 1
}

class ArgList {
    contains Expression[] args
}

// ─── Expressions ─────────────────────────────────────────────────────────────

class ParenExpr extends Expression {
    contains Expression inner
}

class IdentExpr extends Expression {
    String name
}

class ConstantExpr extends Expression {
    contains Constant value
}

class ConstructorExpr extends Expression {
    contains TypeRef constructedType
    contains Expression argument
}

class SumExpr extends Expression {
    contains Expression[] operands   // grammar requires at least two
}

class TrimExpr extends Expression {
    contains Expression subject
    contains Expression period
}

class ProjExpr extends Expression {
    String subject
    String dimension      // optional; null if omitted
    String target
}

class PeriodOpExpr extends Expression {
    boolean leftClosed    // true = '[', false = ']'
    contains Expression lower
    contains Expression upper
    boolean rightClosed   // true = ']', false = '['
}

class IteratorExpr extends Expression {
    String iteratorName   // text of ITERATOR token (includes trailing .element)
}

class RightUnaryOpExpr extends Expression {
    contains Expression operand
    BuiltinOpKind opkind     // START or END
}

class LeftUnaryOpExpr extends Expression {
    BuiltinOpKind opkind
    contains Expression operand
}

class BinaryOpExpr extends Expression {
    contains Expression left
    BuiltinOpKind opkind
    contains Expression right
}

class UserKeywordPrefixExpr extends Expression {
    String keyword
    contains Expression operand
}

class UserKeywordInfixExpr extends Expression {
    contains Expression left
    String keyword
    contains Expression right
}

class UserKeywordPostfixExpr extends Expression {
    contains Expression operand
    String keyword
}

class ElementExpr extends Expression {}

class TerminateExpr extends Expression {}

class WhenExpr extends Expression {
    contains Expression condition
    contains Expression thenExpr
}

class AtExpr extends Expression {
    contains Expression subject
    contains Expression atTime
}

class IntegrateExpr extends Expression {
    contains Expression integrand
    contains Expression period
}

class TickExpr extends Expression {
    String clockId
}

class ComponentRefExpr extends Expression {
    boolean relative           // true when leading '.' is present
    contains ComponentStep[] steps
}

class ComponentStep {
    String name
    contains Subscript[] subscripts
}

class Subscript {
    boolean slice              // true for ':', false for an index expression
    contains Expression index  // null when slice == true
}

class IfExpr extends Expression {
    contains Expression condition
    contains Expression thenExpr
    contains Expression elseExpr
}

class SetExpr extends Expression {
    contains Expression[] elements  // empty list represents '{}'
}

class EvaluateExpr extends Expression {
    contains Expression subject
}

// ─── Constants ───────────────────────────────────────────────────────────────
class BooleanValue {} //TODO placeholder

abstract class Constant {}

class StringConstant extends Constant {
    String value
}

class NumberConstant extends Constant {
    double value
}

enum BooleanConstant {
    TRUE = 0
    FALSE = 1
    UNDECIDED = 2
    UNDEFINED = 3
}
