model LiftOneAxis_no_ext is {
	// One operator applied to every element of a set: 'f' S.element is the set
	// { 'f' b1, 'f' b2 }. An aggregator folds the set into one value.

	// Translated to a Modelica function
	Operator [ Boolean ] 'negate' Boolean b = not b;

	// Translated to a Modelica block (it holds an integrator), instantiated once per element
	Operator [ Boolean ] 'evaluate' Boolean phi 'over' Period P = integrate phi on P;

	Boolean b0 is if (1.0 < time) and (time < 5) then true else false;
	Boolean b1 is if (2.0 < time) then true else false;
	Boolean b2 is if (3.0 < time) then true else false;
	Period P1 is [ new Event b0, new Event not b0 ];
	Boolean S is { b1, b2 };

	// User operator that is a function
	Boolean all_negated is and ('negate' S.element); // true until 2s, then false
	// User operator that is a block; P1 is not lifted, so every element is evaluated over the same period
	Boolean all_evaluated is and ('evaluate' S.element 'over' P1);
	// Built-in operator
	Boolean any_false is or (not S.element); // true until 3s, then false
};
