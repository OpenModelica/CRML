model BasicUnit is {
    partial type Pressure is Quantity (SIUnit = "Pa");
    type PressurePa is Pressure (userUnit = "Pa", rate = 1, offset = 0) alias [Pa];
    type PressureBar is Pressure(userUnit = "bar", rate = 1.e5, offset = 0) alias [bar];

    PressureBar P0 is 3; // value = 3 bar in user units and 3.e5 Pa in SI units
    Pressure P1 is 10.e5 [Pa];
    Pressure P2 is 3 [bar]; // conversion of bar to SI units is made automatically
    PressureBar P1Bar is P1;
    Pressure P3 is (P1 + P2) [bar]; // P1 and P2 are automatically converted to SI units, added and the results displayed in bar
    Pressure P4 is (10.e5 [Pa] + 3 [bar]) [bar]; // P3 = P4 
    //Pressure P6 is 3; // ERROR: ommiting the unit is NOT POSSIBLE because Pressure is a partial type that cannot be instantiated
    //Pressure P7 is 3 [K]; // ERROR: specifying a wrong unit is NOT POSSIBLE because K is not a subtype of Pressure
    Pressure P8 is external [bar]; // is allowed
};