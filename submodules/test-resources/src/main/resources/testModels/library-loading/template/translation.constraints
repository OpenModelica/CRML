# A template from a library.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseTemplate"] == 3
count [CustomOperator::@container.name == "Logic"] == 1

# ---- UseTemplate

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseTemplate"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseTemplate.mo"
[TraceLink::@file == "UseTemplate.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseTemplate"
[TraceLink::@file == "UseTemplate.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseTemplate.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseTemplate.mo"] == 0
count [Reference::@file == "UseTemplate.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseTemplate.mo", target.@file != "UseTemplate.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseTemplate.mo"] == 2

# UseTemplate (own): each element once, of the right kind, directly in UseTemplate's class.
count [Variable::@container.name == "UseTemplate"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "VARIABLE_TO_COMPONENT"] == 3
all [Variable::@container.name == "UseTemplate"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseTemplate.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseTemplate", name == "x"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "UseTemplate", name == "y"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"
[Variable::@container.name == "UseTemplate", name == "x_or_y"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x_or_y"

# Logic: each element once, of the right kind, directly in UseTemplate's class.
count [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseTemplate.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseTemplate.trace"].modelica.@container == [TraceLink::@file == "UseTemplate.trace", kind == "MODEL_TO_CLASS"].modelica

# ---- Call sites and structure
# x_or_y calls the function of Logic's 'or'.
[Variable::@container.name == "UseTemplate", name == "x_or_y"].@referrers[TraceLink::@file == "UseTemplate.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "Logic", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "UseTemplate.trace"].modelica
