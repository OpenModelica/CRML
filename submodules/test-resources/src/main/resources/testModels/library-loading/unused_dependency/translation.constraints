# Every operator of a dependency is emitted, used or not.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseNothing"] == 2
count [CustomOperator::@container.name == "Logic"] == 1

# ---- UseNothing

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseNothing"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseNothing.mo"
[TraceLink::@file == "UseNothing.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseNothing"
[TraceLink::@file == "UseNothing.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseNothing.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseNothing.mo"] == 0
count [Reference::@file == "UseNothing.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseNothing.mo", target.@file != "UseNothing.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseNothing.mo"] == 2

# UseNothing (own): each element once, of the right kind, directly in UseNothing's class.
count [Variable::@container.name == "UseNothing"].@referrers[TraceLink::@file == "UseNothing.trace", kind == "VARIABLE_TO_COMPONENT"] == 2
all [Variable::@container.name == "UseNothing"].@referrers[TraceLink::@file == "UseNothing.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseNothing.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseNothing", name == "x"].@referrers[TraceLink::@file == "UseNothing.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "UseNothing", name == "y"].@referrers[TraceLink::@file == "UseNothing.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"

# Logic: each element once, of the right kind, directly in UseNothing's class.
count [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseNothing.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseNothing.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseNothing.trace"].modelica.@container == [TraceLink::@file == "UseNothing.trace", kind == "MODEL_TO_CLASS"].modelica

# ---- Call sites and structure
# y is bound to x; Logic's 'or' is emitted but nothing calls it.
[Variable::@container.name == "UseNothing", name == "y"].@referrers[TraceLink::@file == "UseNothing.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.parts.name == "x"
[CustomOperator::@container.name == "Logic", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "UseNothing.trace"].modelica.@referrers[Reference] is empty
