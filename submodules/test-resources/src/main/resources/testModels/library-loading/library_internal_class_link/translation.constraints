# A class extension inside a library.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseLibraryClass"] == 1
count [Class::@container.name == "Equipment"] == 2

# ---- UseLibraryClass

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseLibraryClass"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseLibraryClass.mo"
[TraceLink::@file == "UseLibraryClass.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseLibraryClass"
[TraceLink::@file == "UseLibraryClass.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseLibraryClass.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseLibraryClass.mo"] == 0
count [Reference::@file == "UseLibraryClass.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseLibraryClass.mo", target.@file != "UseLibraryClass.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseLibraryClass.mo"] == 3

# UseLibraryClass (own): each element once, of the right kind, directly in UseLibraryClass's class.
count [Variable::@container.name == "UseLibraryClass"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "VARIABLE_TO_COMPONENT"] == 1
all [Variable::@container.name == "UseLibraryClass"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseLibraryClass.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseLibraryClass", name == "pump1"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "pump1"

# Equipment: each element once, of the right kind, directly in UseLibraryClass's class.
count [Class::@container.name == "Equipment"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "CLASS_TO_MODEL"] == 2
all [Class::@container.name == "Equipment"].@referrers[TraceLink::@file == "UseLibraryClass.trace"].kind == "CLASS_TO_MODEL"
all [Class::@container.name == "Equipment"].@referrers[TraceLink::@file == "UseLibraryClass.trace"].modelica.@container == [TraceLink::@file == "UseLibraryClass.trace", kind == "MODEL_TO_CLASS"].modelica
[Class::@container.name == "Equipment", name == "Machine"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "CLASS_TO_MODEL"].modelica.name == "Machine"
[Class::@container.name == "Equipment", name == "Pump"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "CLASS_TO_MODEL"].modelica.name == "Pump"

# ---- Call sites and structure
# Pump extends Machine, both generated into the model; pump1 is a Pump.
[Class::@container.name == "Equipment", name == "Pump"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "CLASS_TO_MODEL"].modelica.extendsClauses.superClass.target == [Class::@container.name == "Equipment", name == "Machine"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "CLASS_TO_MODEL"].modelica
[Variable::@container.name == "UseLibraryClass", name == "pump1"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.declaredType.target == [Class::@container.name == "Equipment", name == "Pump"].@referrers[TraceLink::@file == "UseLibraryClass.trace", kind == "CLASS_TO_MODEL"].modelica
