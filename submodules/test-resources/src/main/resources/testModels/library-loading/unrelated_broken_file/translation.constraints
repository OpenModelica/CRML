# A broken file nothing depends on.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseLogic"] == 3
count [CustomOperator::@container.name == "Logic"] == 1
count [CustomOperator::@container.name == "Broken"] == 1

# ---- UseLogic

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseLogic"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseLogic.mo"
[TraceLink::@file == "UseLogic.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseLogic"
[TraceLink::@file == "UseLogic.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseLogic.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseLogic.mo"] == 0
count [Reference::@file == "UseLogic.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseLogic.mo", target.@file != "UseLogic.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseLogic.mo"] == 2

# UseLogic (own): each element once, of the right kind, directly in UseLogic's class.
count [Variable::@container.name == "UseLogic"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "VARIABLE_TO_COMPONENT"] == 3
all [Variable::@container.name == "UseLogic"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseLogic.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseLogic", name == "x"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "UseLogic", name == "y"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"
[Variable::@container.name == "UseLogic", name == "x_or_y"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x_or_y"

# Logic: each element once, of the right kind, directly in UseLogic's class.
count [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseLogic.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "UseLogic.trace"].modelica.@container == [TraceLink::@file == "UseLogic.trace", kind == "MODEL_TO_CLASS"].modelica

# What UseLogic does not reach is not in it: scope flows one way only.
all [CustomOperator::@container.name == "Broken"].@referrers.@file not contains "UseLogic.trace"
all [Class::@container.name == "Broken"].@referrers.@file not contains "UseLogic.trace"
all [Variable::@container.name == "Broken"].@referrers.@file not contains "UseLogic.trace"

# ---- Call sites and structure
# x_or_y calls the function of Logic's 'or'.
[Variable::@container.name == "UseLogic", name == "x_or_y"].@referrers[TraceLink::@file == "UseLogic.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "Logic", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "UseLogic.trace"].modelica
