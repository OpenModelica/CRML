# Every variable of UseTwo has a type, and there are variables to check.
all [Model::name == "UseTwo"] / [Variable].domain is not empty
count [Model::name == "UseTwo"] / [Variable] >= 1

# Operators of both libraries in one expression; "(x 'or' y)" is a SUBEXPRESSION, hence .value.value.
[Variable::name == "nor"].definition.operator.@root.name == "Negation"
[Variable::name == "nor"].definition.bindings.value.value.operator.@root.name == "Logic"
count [Model::name == "UseTwo"] / [Sequence] == 0
