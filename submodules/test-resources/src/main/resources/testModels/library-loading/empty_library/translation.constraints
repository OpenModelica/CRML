# An empty library adds nothing.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseEmpty"] == 1
count [CustomOperator::@container.name == "Empty"] == 0
count [Class::@container.name == "Empty"] == 0
count [Variable::@container.name == "Empty"] == 0

# ---- UseEmpty

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseEmpty"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseEmpty.mo"
[TraceLink::@file == "UseEmpty.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseEmpty"
[TraceLink::@file == "UseEmpty.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseEmpty.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseEmpty.mo"] == 0
count [Reference::@file == "UseEmpty.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseEmpty.mo", target.@file != "UseEmpty.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseEmpty.mo"] == 1

# UseEmpty (own): each element once, of the right kind, directly in UseEmpty's class.
count [Variable::@container.name == "UseEmpty"].@referrers[TraceLink::@file == "UseEmpty.trace", kind == "VARIABLE_TO_COMPONENT"] == 1
all [Variable::@container.name == "UseEmpty"].@referrers[TraceLink::@file == "UseEmpty.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseEmpty.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseEmpty", name == "x"].@referrers[TraceLink::@file == "UseEmpty.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
