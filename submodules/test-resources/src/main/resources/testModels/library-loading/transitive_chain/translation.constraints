# A reached through the empty libraries C and B.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseChain"] == 3
count [CustomOperator::@container.name == "A"] == 1
count [CustomOperator::@container.name == "B"] == 0
count [Class::@container.name == "B"] == 0
count [Variable::@container.name == "B"] == 0
count [CustomOperator::@container.name == "C"] == 0
count [Class::@container.name == "C"] == 0
count [Variable::@container.name == "C"] == 0

# ---- UseChain

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseChain"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseChain.mo"
[TraceLink::@file == "UseChain.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseChain"
[TraceLink::@file == "UseChain.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseChain.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseChain.mo"] == 0
count [Reference::@file == "UseChain.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseChain.mo", target.@file != "UseChain.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseChain.mo"] == 2

# UseChain (own): each element once, of the right kind, directly in UseChain's class.
count [Variable::@container.name == "UseChain"].@referrers[TraceLink::@file == "UseChain.trace", kind == "VARIABLE_TO_COMPONENT"] == 3
all [Variable::@container.name == "UseChain"].@referrers[TraceLink::@file == "UseChain.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseChain.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseChain", name == "x"].@referrers[TraceLink::@file == "UseChain.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "UseChain", name == "y"].@referrers[TraceLink::@file == "UseChain.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"
[Variable::@container.name == "UseChain", name == "x_or_y"].@referrers[TraceLink::@file == "UseChain.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x_or_y"

# A: each element once, of the right kind, directly in UseChain's class.
count [CustomOperator::@container.name == "A"].@referrers[TraceLink::@file == "UseChain.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "A"].@referrers[TraceLink::@file == "UseChain.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "A"].@referrers[TraceLink::@file == "UseChain.trace"].modelica.@container == [TraceLink::@file == "UseChain.trace", kind == "MODEL_TO_CLASS"].modelica

# ---- Call sites and structure
# x_or_y calls the function of A's 'or'.
[Variable::@container.name == "UseChain", name == "x_or_y"].@referrers[TraceLink::@file == "UseChain.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "A", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "UseChain.trace"].modelica
