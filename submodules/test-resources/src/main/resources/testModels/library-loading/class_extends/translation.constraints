# A model class extending a library class.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Class::@container.name == "ExtendClass"] == 1
count [Variable::@container.name == "ExtendClass"] == 1
count [Class::@container.name == "Equipment"] == 1

# ---- ExtendClass

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "ExtendClass"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "ExtendClass.mo"
[TraceLink::@file == "ExtendClass.trace", kind == "MODEL_TO_CLASS"].modelica.name == "ExtendClass"
[TraceLink::@file == "ExtendClass.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "ExtendClass.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "ExtendClass.mo"] == 0
count [Reference::@file == "ExtendClass.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "ExtendClass.mo", target.@file != "ExtendClass.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "ExtendClass.mo"] == 3

# ExtendClass (own): each element once, of the right kind, directly in ExtendClass's class.
count [Class::@container.name == "ExtendClass"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"] == 1
all [Class::@container.name == "ExtendClass"].@referrers[TraceLink::@file == "ExtendClass.trace"].kind == "CLASS_TO_MODEL"
all [Class::@container.name == "ExtendClass"].@referrers[TraceLink::@file == "ExtendClass.trace"].modelica.@container == [TraceLink::@file == "ExtendClass.trace", kind == "MODEL_TO_CLASS"].modelica
[Class::@container.name == "ExtendClass", name == "Pump"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"].modelica.name == "Pump"
count [Variable::@container.name == "ExtendClass"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "VARIABLE_TO_COMPONENT"] == 1
all [Variable::@container.name == "ExtendClass"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "ExtendClass.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "ExtendClass", name == "pump1"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "pump1"

# Equipment: each element once, of the right kind, directly in ExtendClass's class.
count [Class::@container.name == "Equipment"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"] == 1
all [Class::@container.name == "Equipment"].@referrers[TraceLink::@file == "ExtendClass.trace"].kind == "CLASS_TO_MODEL"
all [Class::@container.name == "Equipment"].@referrers[TraceLink::@file == "ExtendClass.trace"].modelica.@container == [TraceLink::@file == "ExtendClass.trace", kind == "MODEL_TO_CLASS"].modelica
[Class::@container.name == "Equipment", name == "Machine"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"].modelica.name == "Machine"

# ---- Call sites and structure
# Pump extends the Machine generated into the same model; pump1 is a Pump.
[Class::@container.name == "ExtendClass", name == "Pump"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"].modelica.extendsClauses.superClass.target == [Class::@container.name == "Equipment", name == "Machine"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"].modelica
[Variable::@container.name == "ExtendClass", name == "pump1"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.declaredType.target == [Class::@container.name == "ExtendClass", name == "Pump"].@referrers[TraceLink::@file == "ExtendClass.trace", kind == "CLASS_TO_MODEL"].modelica
