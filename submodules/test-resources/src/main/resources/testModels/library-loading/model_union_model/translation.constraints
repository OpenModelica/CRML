# A model depending on a model: Base's elements are emitted into both.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [CustomOperator::@container.name == "Base"] == 1
count [Variable::@container.name == "Base"] == 2
count [Variable::@container.name == "Derived"] == 1

# ---- Base

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "Base"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "Base.mo"
[TraceLink::@file == "Base.trace", kind == "MODEL_TO_CLASS"].modelica.name == "Base"
[TraceLink::@file == "Base.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "Base.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "Base.mo"] == 0
count [Reference::@file == "Base.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "Base.mo", target.@file != "Base.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "Base.mo"] == 2

# Base (own): each element once, of the right kind, directly in Base's class.
count [CustomOperator::@container.name == "Base"].@referrers[TraceLink::@file == "Base.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Base"].@referrers[TraceLink::@file == "Base.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Base"].@referrers[TraceLink::@file == "Base.trace"].modelica.@container == [TraceLink::@file == "Base.trace", kind == "MODEL_TO_CLASS"].modelica
count [Variable::@container.name == "Base"].@referrers[TraceLink::@file == "Base.trace", kind == "VARIABLE_TO_COMPONENT"] == 2
all [Variable::@container.name == "Base"].@referrers[TraceLink::@file == "Base.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "Base.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "Base", name == "x"].@referrers[TraceLink::@file == "Base.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "Base", name == "y"].@referrers[TraceLink::@file == "Base.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"

# What Base does not reach is not in it: scope flows one way only.
all [CustomOperator::@container.name == "Derived"].@referrers.@file not contains "Base.trace"
all [Class::@container.name == "Derived"].@referrers.@file not contains "Base.trace"
all [Variable::@container.name == "Derived"].@referrers.@file not contains "Base.trace"

# ---- Derived

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "Derived"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "Derived.mo"
[TraceLink::@file == "Derived.trace", kind == "MODEL_TO_CLASS"].modelica.name == "Derived"
[TraceLink::@file == "Derived.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "Derived.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "Derived.mo"] == 0
count [Reference::@file == "Derived.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "Derived.mo", target.@file != "Derived.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "Derived.mo"] == 2

# Derived (own): each element once, of the right kind, directly in Derived's class.
count [Variable::@container.name == "Derived"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"] == 1
all [Variable::@container.name == "Derived"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "Derived.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "Derived", name == "x_or_y"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x_or_y"

# Base: each element once, of the right kind, directly in Derived's class.
count [CustomOperator::@container.name == "Base"].@referrers[TraceLink::@file == "Derived.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Base"].@referrers[TraceLink::@file == "Derived.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Base"].@referrers[TraceLink::@file == "Derived.trace"].modelica.@container == [TraceLink::@file == "Derived.trace", kind == "MODEL_TO_CLASS"].modelica
count [Variable::@container.name == "Base"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"] == 2
all [Variable::@container.name == "Base"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "Derived.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "Base", name == "x"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "Base", name == "y"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"

# ---- Call sites and structure
# x_or_y calls the function of Base's 'or'.
[Variable::@container.name == "Derived", name == "x_or_y"].@referrers[TraceLink::@file == "Derived.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "Base", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "Derived.trace"].modelica
