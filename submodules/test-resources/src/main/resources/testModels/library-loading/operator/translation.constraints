# A keyword operator from a library.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [Variable::@container.name == "UseOperator"] == 2
count [CustomOperator::@container.name == "Negation"] == 1

# ---- UseOperator

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "UseOperator"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "UseOperator.mo"
[TraceLink::@file == "UseOperator.trace", kind == "MODEL_TO_CLASS"].modelica.name == "UseOperator"
[TraceLink::@file == "UseOperator.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "UseOperator.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "UseOperator.mo"] == 0
count [Reference::@file == "UseOperator.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "UseOperator.mo", target.@file != "UseOperator.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "UseOperator.mo"] == 2

# UseOperator (own): each element once, of the right kind, directly in UseOperator's class.
count [Variable::@container.name == "UseOperator"].@referrers[TraceLink::@file == "UseOperator.trace", kind == "VARIABLE_TO_COMPONENT"] == 2
all [Variable::@container.name == "UseOperator"].@referrers[TraceLink::@file == "UseOperator.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "UseOperator.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "UseOperator", name == "x"].@referrers[TraceLink::@file == "UseOperator.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "UseOperator", name == "not_x"].@referrers[TraceLink::@file == "UseOperator.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "not_x"

# Negation: each element once, of the right kind, directly in UseOperator's class.
count [CustomOperator::@container.name == "Negation"].@referrers[TraceLink::@file == "UseOperator.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Negation"].@referrers[TraceLink::@file == "UseOperator.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Negation"].@referrers[TraceLink::@file == "UseOperator.trace"].modelica.@container == [TraceLink::@file == "UseOperator.trace", kind == "MODEL_TO_CLASS"].modelica

# ---- Call sites and structure
# not_x calls Negation's function.
[Variable::@container.name == "UseOperator", name == "not_x"].@referrers[TraceLink::@file == "UseOperator.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "Negation", keywords.keyword contains "'negation of'"].@referrers[TraceLink::@file == "UseOperator.trace"].modelica
