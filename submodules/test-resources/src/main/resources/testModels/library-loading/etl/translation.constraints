[Variable::@container.name == "BecomesTrueInside", name == "c_b1_becomes_true_inside_p1"].definition.@referrers[TraceLink::@file == "BecomesTrueInside.trace", kind == "VALUE_TO_COMPONENT"].modelica.declaredType.target == [CustomOperator::@container.name == "ETL", keywords.keyword contains "'becomes true inside'"].@referrers[TraceLink::@file == "BecomesTrueInside.trace"].modelica
[Variable::@container.name == "CheckOver", name == "b_check_over"].definition.@referrers[TraceLink::@file == "CheckOver.trace", kind == "VALUE_TO_COMPONENT"].modelica.declaredType.target == [CustomOperator::@container.name == "ETL", keywords.keyword contains "'check'"].@referrers[TraceLink::@file == "CheckOver.trace"].modelica
[Variable::@container.name == "CountInside", name == "i_count_ticks_of_c1_inside_p1"].definition.@referrers[TraceLink::@file == "CountInside.trace", kind == "VALUE_TO_COMPONENT"].modelica.declaredType.target == [CustomOperator::@container.name == "ETL", keywords.keyword contains "'count'"].@referrers[TraceLink::@file == "CountInside.trace"].modelica
# Operators calling operators of the same library.
[CustomOperator::@container.name == "ETL", keywords.keyword contains "'becomes true inside'"].@referrers[TraceLink::@file == "BecomesTrueInside.trace"].modelica.components.declaredType[Reference::target.name != ""].target contains [CustomOperator::@container.name == "ETL", keywords.keyword == "'inside'"].@referrers[TraceLink::@file == "BecomesTrueInside.trace"].modelica
[CustomOperator::@container.name == "ETL", keywords.keyword contains "'count'"].@referrers[TraceLink::@file == "CountInside.trace"].modelica.components.declaredType[Reference::target.name != ""].target contains [CustomOperator::@container.name == "ETL", keywords.keyword == "'inside'"].@referrers[TraceLink::@file == "CountInside.trace"].modelica
[CustomOperator::@container.name == "ETL", keywords.keyword contains "'check'"].@referrers[TraceLink::@file == "CheckOver.trace"].modelica.components.declaredType[Reference::target.name != ""].target contains [CustomOperator::@container.name == "ETL", keywords.keyword contains "'evaluate'"].@referrers[TraceLink::@file == "CheckOver.trace"].modelica
