# Model and library operators mixed.
# <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
# (see LibraryLoading in :compiler and "Checking a translation" in
# CONSTRAINT_LANGUAGE.md). Every expected value follows from the CRML sources.

# What is quantified over, so that no 'all' below passes vacuously.
count [CustomOperator::@container.name == "MixLocal"] == 2
count [Variable::@container.name == "MixLocal"] == 4
count [CustomOperator::@container.name == "Logic"] == 1

# ---- MixLocal

# Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
[Model::name == "MixLocal"].@referrers[TraceLink::kind == "MODEL_TO_CLASS"].modelica.@file == "MixLocal.mo"
[TraceLink::@file == "MixLocal.trace", kind == "MODEL_TO_CLASS"].modelica.name == "MixLocal"
[TraceLink::@file == "MixLocal.trace", kind == "MODEL_TO_CLASS"].modelica.partial == true

# Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
count [TraceLink::@file == "MixLocal.trace", kind == "UNSUPPORTED"] == 0
count [Placeholder::@file == "MixLocal.mo"] == 0
count [Reference::@file == "MixLocal.mo", reason == "UNRESOLVED", rawText != ""] == 0
count [Reference::@file == "MixLocal.mo", target.@file != "MixLocal.mo"] == 0

# Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
count [ClassDefinition::@file == "MixLocal.mo"] == 4

# MixLocal (own): each element once, of the right kind, directly in MixLocal's class.
count [CustomOperator::@container.name == "MixLocal"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "OPERATOR_TO_FUNCTION"] == 2
all [CustomOperator::@container.name == "MixLocal"].@referrers[TraceLink::@file == "MixLocal.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "MixLocal"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica.@container == [TraceLink::@file == "MixLocal.trace", kind == "MODEL_TO_CLASS"].modelica
count [Variable::@container.name == "MixLocal"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"] == 4
all [Variable::@container.name == "MixLocal"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.@container == [TraceLink::@file == "MixLocal.trace", kind == "MODEL_TO_CLASS"].modelica
[Variable::@container.name == "MixLocal", name == "x"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x"
[Variable::@container.name == "MixLocal", name == "y"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "y"
[Variable::@container.name == "MixLocal", name == "x_implies_y"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "x_implies_y"
[Variable::@container.name == "MixLocal", name == "nor"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.name == "nor"

# Logic: each element once, of the right kind, directly in MixLocal's class.
count [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "OPERATOR_TO_FUNCTION"] == 1
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "MixLocal.trace"].kind == "OPERATOR_TO_FUNCTION"
all [CustomOperator::@container.name == "Logic"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica.@container == [TraceLink::@file == "MixLocal.trace", kind == "MODEL_TO_CLASS"].modelica

# ---- Call sites and structure
# The model's own operators are called, and they and the model call Logic's 'or'.
[Variable::@container.name == "MixLocal", name == "x_implies_y"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "MixLocal", keywords.keyword contains "'implies'"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica
[CustomOperator::@container.name == "MixLocal", keywords.keyword contains "'implies'"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica.statements.value.function.target == [CustomOperator::@container.name == "Logic", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica
[Variable::@container.name == "MixLocal", name == "nor"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.function.target == [CustomOperator::@container.name == "MixLocal", keywords.keyword contains "'negation of'"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica
[Variable::@container.name == "MixLocal", name == "nor"].@referrers[TraceLink::@file == "MixLocal.trace", kind == "VARIABLE_TO_COMPONENT"].modelica.binding.arguments[ParenthesizedExpression].inner.function.target == [CustomOperator::@container.name == "Logic", keywords.keyword contains "'or'"].@referrers[TraceLink::@file == "MixLocal.trace"].modelica
