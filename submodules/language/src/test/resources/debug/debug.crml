model CategoryAssociationExample1 is {	
	Operator [ Boolean ] Period P 'decide at end' Boolean b = true;
	
	// Decide that decision event to evaluate requirement is any time instant of a time period
	Operator [ Boolean ] Periods P 'decide anytime' Boolean b = true;
	
	Period P is external;
	Boolean phi is external;
		
	Boolean y_decide_at_end is P 'decide at end' phi; // Value should be equal to (P_end)
	Boolean y_decide_at_any_time is P 'decide anytime' P 'decide at end' phi; // Value should be equal to true
	
};